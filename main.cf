# ============================================================
# POSTFIX - Configuración principal
# Dominio: imad.local
# ============================================================

compatibility_level = 3.9

# --- IDENTIDAD DEL SERVIDOR ---
myhostname = mail.imad.local
mydomain = imad.local
myorigin = $mydomain

# --- BANNER ---
smtpd_banner = $myhostname ESMTP

# --- INTERFACES Y PROTOCOLOS ---
inet_interfaces = all
inet_protocols = all

# --- DESTINOS LOCALES ---
mydestination = $myhostname, $mydomain, mail.imad.local, localhost.imad.local, localhost

# --- REDES DE CONFIANZA ---
mynetworks = 127.0.0.0/8 192.168.75.0/24 [::ffff:127.0.0.0]/104 [::1]/128

# --- BUZONES MAILDIR ---
home_mailbox = Maildir/
mailbox_size_limit = 0

# --- ALIASES ---
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases

# --- OTROS ---
biff = no
recipient_delimiter = +
relayhost =
mailbox_command =

# --- TLS ---
smtpd_tls_key_file = /etc/ssl/private/mail.imad.local.key
smtpd_tls_cert_file = /etc/ssl/certs/mail.imad.local.crt
smtpd_tls_security_level = may
smtp_tls_CAfile = /etc/ssl/CA/ca.crt
smtp_tls_security_level = may
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

# --- RESTRICCIONES RELAY ---
smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination

# --- SASL ---
cyrus_sasl_config_path = /etc/postfix/sasl

# --- TAMAÑO MÁXIMO DE MENSAJE (50MB) ---
message_size_limit = 52428800
content_filter = smtp-amavis:[127.0.0.1]:10024
smtpd_tls_CAfile = /etc/ssl/CA/ca.crt
smtpd_tls_auth_only = yes
smtp_tls_cert_file = /etc/ssl/certs/mail.imad.local.crt
smtp_tls_key_file = /etc/ssl/private/mail.imad.local.key
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
